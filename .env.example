# ---------------------------------------------------------------------------
# VELLUM environment variables
# Copy this file to `.env.local` and fill in real values before deploying.
# Never commit `.env*` files. See docs/runbook.md for the full breakdown.
# ---------------------------------------------------------------------------

# ---- Required ----
# Postgres connection string. The app refuses to start without it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# >= 32 characters. Seals iron-session auth cookies. Rotating it signs
# every existing session out.
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-chars

# ---- Deployment / branding ----
# Canonical origin, e.g. https://vellum.com. Drives metadataBase, OG URLs,
# robots.txt and the sitemap. Set it BEFORE `next build` (baked in at build).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Runtime modes (see runbook) ----
# 0 = public SaaS (require real sign-in at /signin).
# The app REFUSES to run in production unless VELLUM_AMBIENT="0" or
# VELLUM_SINGLE_USER="1" — with ambient on and not single-user, every visitor
# would be auto-adopted into the shared demo account and could claim
# owner-less projects.
VELLUM_AMBIENT=0
# 1 = one shared household studio with no sign-in friction
VELLUM_SINGLE_USER=0

# ---- Optional services (graceful without them) ----
# Email delivery for sign-in codes (without it, codes log to console)
RESEND_API_KEY=
RESEND_FROM=VELLUM <login@vellum.app>

# Model-powered prose polish + follow-up question generation
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
POLISH_MODEL=

# Hardcover checkout + payment confirmation
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Print-on-demand fulfillment for paid hardcovers
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# 0 = live Lulu printing (production value). 1 = Lulu sandbox: orders are
# marked "fulfilled" but no book is ever printed or shipped. The sandbox is
# the default when unset, so production MUST set 0 or fulfillment silently
# breaks.
LULU_SANDBOX=0